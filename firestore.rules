rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Items Rules (Public campus QR scanner & owner dashboard)
    match /items/{itemId} {
      allow read, write, create, update, delete: if true;
    }

    // Found Reports Rules
    match /foundReports/{reportId} {
      allow read, write, create, update: if true;
    }

    // Notifications Rules
    match /notifications/{notificationId} {
      allow read, write, create, update: if true;
    }

    // Handover Verifications Rules
    match /handoverVerifications/{verificationId} {
      allow read, write, create, update: if true;
    }

    // Item History Audit Rules
    match /itemHistory/{historyId} {
      allow read, write, create: if true;
    }
  }
}
